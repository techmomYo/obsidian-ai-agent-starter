# .env.example — template for environment variables, never commit .env
# Copy this file to .env and fill in real values before running any agent scripts.
# .env is gitignored — never commit it. This file (.env.example) is safe to commit.
# Replace every value below with your own. Add new keys here, never real values.

ANTHROPIC_API_KEY=[REPLACE: your-anthropic-api-key]
