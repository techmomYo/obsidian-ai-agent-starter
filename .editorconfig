# .editorconfig — standard editor configuration for consistent formatting across tools
root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,md,yaml,yml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2
